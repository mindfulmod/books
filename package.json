{
  "name": "ihya-interactive-showcase",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "npm run check:ihya && npm run check:theme && npm run check:workspace && npm run check:inner && npm run check:seeds",
    "check:ihya": "node scripts/check-ihya.mjs",
    "check:build": "node scripts/check-build.mjs",
    "sync:catalog": "node scripts/sync-book-navigation.mjs",
    "check:theme": "node scripts/check-reader-theme.cjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/prepare-pages.mjs && npm run check:build && npm run check:names",
    "preview": "vite preview --host 127.0.0.1",
    "check:workspace": "node scripts/check-reading-workspace.mjs",
    "check:inner": "python3 scripts/check-inner-dimensions.py && node scripts/check-inner-appearance.mjs",
    "check:seeds": "node scripts/check-timeless-seeds.mjs && node scripts/check-seeds-appearance.mjs",
    "check:names": "node --test src/names/*.test.mjs && node scripts/check-beautiful-names.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
